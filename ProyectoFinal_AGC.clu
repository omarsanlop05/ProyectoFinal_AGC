DefVarsN3();
DrawFrame(0.5,"axes");

//*
//Función cilindro modificada
Cilindro = {
	//Entrada de datos: _P(#)
	A = _P(1); //Entrada 1: Punto inicial del cilindro
	B = _P(2); //Entrada 2: Punto final del cilindro
	r = _P(3); //Entrada 3: Radio del cilindro
	
	E = einf^e0; //Plano de Minkowski
	Ae = (A^E)*E; //Quitar parte "conformal" a Punto A
	Be = (B^E)*E; //Quitar parte "conformal" a Punto B
	Ce = Be - Ae; //Vector de direcciï¿½n en Euclidiano que va de A a B
	C = Ce + 1/2*Ce^^2*einf + e0; // Vector Ce en conformal
	DrawCylinder(A,C,r);
	[C,Ce,"Hola"] // Salida(s)
}

Box = {
	C = _P(1); // Entrada 1: Punto centro de la caja
	X = _P(2); // Entrada 2: Punto dirección 1
	Y = _P(3); // Entrada 3: Punto dirección 2
	Z = _P(4); // Entrada 4: Punto dirección 3
	
	E = einf^e0; // Plano de Minkowski
	D1e = ((X-C)^E)*E;
	D2e = ((Y-C)^E)*E;
	D3e = ((Z-C)^E)*E;
	D1 = D1e + 1/2*D1e^^2*einf + e0;
	D2 = D2e + 1/2*D2e^^2*einf + e0;
	D3 = D3e + 1/2*D3e^^2*einf + e0;
	DrawBox(C,D1,D2,D3);
}

:IPNS;
check = CheckBox("Animar",false);
EnableAnimate(check);

if(ExecMode & !EM_ANIMATE)
{
	Data = ReadData("datos.dat");
	?N = Size(Data);
}

if(check){
//Numero de elementos de la lista
	?i = round(Time*200,0)%N+1;
	
////////////////
//Movimiento general
	BFx = Data(i,1);
	BFy = Data(i,2);
	BFz = Data(i,3);
	BFRx = Data(i,4);
	BFRy = Data(i,5);
	BFRz = Data(i,6);

//Columna
	LLJxr = Data(i,7);
	LLJzr = Data(i,8);

//Cuello
	LNJxr = Data(i,9);
	LNJyr = Data(i,10);

//Hombro izquierdo
	SJLxr = Data(i,11);
	SJLyr = Data(i,12);
	SJLzr = Data(i,13);

//Codo izquierdo
	EJLxr = Data(i,14);

//Hombro derecho
	SJRxr = Data(i,15);
	SJRyr = Data(i,16);
	SJRzr = Data(i,17);

//Codo derecho
	EJRxr = Data(i,18);

//Cadera izquierda
	HJLxr = Data(i,19);
	HJLyr = Data(i,20);
	HJLzr = Data(i,21);

//Rodilla izquierda
	KJLxr = Data(i,22);

//Tobillo izquierdo
	AJLxr = Data(i,23);
	AJLyr = Data(i,24);
	AJLzr = Data(i,25);

//Cadera derecha
	HJRxr = Data(i,26);
	HJRyr = Data(i,27);
	HJRzr = Data(i,28);

//Rodilla derecha
	KJRxr = Data(i,29);

//Tobillo derecho
	AJRxr = Data(i,30);
	AJRyr = Data(i,31);
	AJRzr = Data(i,32);
} else {
////////////////
	//Movimiento general
	BFx = Slider("Body Forward X", -5,5,0.1,0);
	BFy = Slider("Body Forward Y", -5,5,0.1,0);
	BFz = Slider("Body Forward Z", -5,5,0.1,0);
	BFRx = Slider("Body Rotation X", -Pi,Pi,0.1,0);
	BFRy = Slider("Body Rotation Y", -Pi,Pi,0.1,0);
	BFRz = Slider("Body Rotation Z", -Pi,Pi,0.1,0);

//Columna
	LLJxr = Slider("Lumbar Rotation X", -5,5,0.1,0);
	LLJzr = Slider("Lumbar Rotation Z", -5,5,0.1,0);

//Cuello
	LNJxr = Slider("Neck Rotation X", -5,5,0.1,0);
	LNJyr = Slider("Neck Rotation Y", -5,5,0.1,0);

//Hombro izquierdo
	SJLxr = Slider("Left Shoulder Rotation X", -5,5,0.1,0);
	SJLyr = Slider("Left Shoulder Rotation Y", -5,5,0.1,0);
	SJLzr = Slider("Left Shoulder Rotation Z", -5,5,0.1,0);

//Codo izquierdo
	EJLxr = Slider("Left Elbow Rotation X", -5,5,0.1,0);

//Hombro derecho
	SJRxr = Slider("Right Shoulder Rotation X", -5,5,0.1,0);
	SJRyr = Slider("Right Shoulder Rotation Y", -5,5,0.1,0);
	SJRzr = Slider("Right Shoulder Rotation Z", -5,5,0.1,0);

//Codo derecho
	EJRxr = Slider("Right Elbow Rotation X", -5,5,0.1,0);

//Cadera izquierda
	HJLxr = Slider("Left Hip Rotation X", -5,5,0.1,0);
	HJLyr = Slider("Left Hip Rotation Y", -5,5,0.1,0);
	HJLzr = Slider("Left Hip Rotation Z", -5,5,0.1,0);

//Rodilla izquierda
	KJLxr = Slider("Left Knee Rotation X", -5,5,0.1,0);

//Tobillo izquierdo
	AJLxr = Slider("Left Anckle Rotation X", -5,5,0.1,0);
	AJLyr = Slider("Left Anckle Rotation Y", -5,5,0.1,0);
	AJLzr = Slider("Left Anckle Rotation Z", -5,5,0.1,0);

//Cadera derecha
	HJRxr = Slider("Right Hip Rotation X", -5,5,0.1,0);
	HJRyr = Slider("Right Hip Rotation Y", -5,5,0.1,0);
	HJRzr = Slider("Right Hip Rotation Z", -5,5,0.1,0);

//Rodilla derecha
	KJRxr = Slider("Right Knee Rotation X", -5,5,0.1,0);

//Tobillo derecho
	AJRxr = Slider("Right Anckle Rotation X", -5,5,0.1,0);
	AJRyr = Slider("Right Anckle Rotation Y", -5,5,0.1,0);
	AJRzr = Slider("Right Anckle Rotation Z", -5,5,0.1,0);
}
////////////////

//Motor global
Mg = TranslatorN3(BFx,BFy,BFz)*RotorN3(1,0,0,BFRx)*RotorN3(0,1,0,BFRy)*RotorN3(1,0,0,BFRz);
M = Mg; //motor auxiliar "acumulado"

////////////////

// Cuerpo
x = 0.01; // Escala 1 = mm
Ptorso = M*e0*(~M); //Punto inicial (origen)
Lt = 409.4*x;   // torso
Ln = 120*x;		// cuello
Ls = 176.3*x;   // hombros
La = 239.3*x;   // brazo
Lf = 250*x;     // antebrazo
Lh = 186.7*x; 	// ancho cadera
Hh = 119.8*x; 	// altura cadera
Lp = 380.6*x;   // pierna
Lc = 358.6*x;   // pantorrilla
Sk = 207.9*x;   // separación rodillas
Sa = 211.6*x;   // separación tobillos
Hf = 71.8*x;	// altura pues

// Movimiento lumbar
Rlumbar = RotorN3(1,0,0,LLJxr)*RotorN3(0,0,1,LLJzr);
Tlumbar = TranslatorN3(0,Lt,0);
Mlumbar = Rlumbar * Tlumbar;
Mtorso = M * Mlumbar;
Pchest = Mtorso * e0 * (~Mtorso);

// Movimiento cuello
Rneck = RotorN3(1,0,0,LNJxr)*RotorN3(0,1,0,LNJyr);
Tneck = TranslatorN3(0,Ln,0);
Mneck = Mtorso * Rneck * Tneck;
Phead = Mneck * e0 * (~Mneck);

// Movimiento brazo izquierdo
// Hombro izquierdo
TshoulderL = TranslatorN3(-0.5, Lt, 0);
RshoulderL = RotorN3(1,0,0,SJLxr)*RotorN3(0,1,0,SJLyr)*RotorN3(0,0,1,SJLzr);
TarmL = TranslatorN3(0,-La,0);
MarmL = M * TshoulderL * RshoulderL * TarmL;
PshoulderL = (M * TshoulderL) * e0 * (~(M * TshoulderL));
PelbowL = MarmL * e0 * (~MarmL);

// Codo izquierdo
RelbowL = RotorN3(1,0,0,EJLxr);
TforearmL = TranslatorN3(0,-Lf,0);
MforearmL = MarmL * RelbowL * TforearmL;
PhandL = MforearmL * e0 * (~MforearmL);

// Movimiento brazo derecho
// Hombro derecho
TshoulderR = TranslatorN3(0.5, Lt, 0);
RshoulderR = RotorN3(1,0,0,SJRxr)*RotorN3(0,1,0,SJRyr)*RotorN3(0,0,1,SJRzr);
TarmR = TranslatorN3(0,-La,0);
MarmR = M * TshoulderR * RshoulderR * TarmR;
PshoulderR = (M * TshoulderR) * e0 * (~(M * TshoulderR));
PelbowR = MarmR * e0 * (~MarmR);

// Codo derecho
RelbowR = RotorN3(1,0,0,EJRxr);
TforearmR = TranslatorN3(0,-Lf,0);
MforearmR = MarmR * RelbowR * TforearmR;
PhandR = MforearmR * e0 * (~MforearmR);

// Cadera
ThipL = TranslatorN3(-0.3,0,0);
RhipL = RotorN3(1,0,0,HJLxr)*RotorN3(0,1,0,HJLyr)*RotorN3(0,0,1,HJLzr);
PhipL = (M * ThipL) * e0 * (~(M * ThipL));
ThipR = TranslatorN3(0.3,0,0); // 0.3 positivo
RhipR = RotorN3(1,0,0,HJRxr)*RotorN3(0,1,0,HJRyr)*RotorN3(0,0,1,HJRzr);
PhipR = (M * ThipR) * e0 * (~(M * ThipR));

// Movimiento piernas
// Pierna izquierda
TlegL = TranslatorN3(0,-Lp,0);
MlegL = M * ThipL * RhipL * TlegL;
PkneeL = MlegL * e0 * (~MlegL);

// Rodilla izquierda
RkneeL = RotorN3(1,0,0,KJLxr);
TcalfL = TranslatorN3(0,-Lc,0);
McalfL = MlegL * RkneeL * TcalfL;
PankleL = McalfL * e0 * (~McalfL);

// Tobillo y pie izquierdo
RankleL = RotorN3(1,0,0,AJLxr)*RotorN3(0,1,0,AJLyr)*RotorN3(0,0,1,AJLzr);
TfootL = TranslatorN3(0, -Hf, 150*x); 
MfootL = McalfL * RankleL * TfootL;
PfootL = MfootL * e0 * (~MfootL);

// Pierna derecha
TlegR = TranslatorN3(0,-Lp,0);
MlegR = M * ThipR * RhipR * TlegR;
PkneeR = MlegR * e0 * (~MlegR);

// Rodilla derecha
RkneeR = RotorN3(1,0,0,KJRxr);
TcalfR = TranslatorN3(0,-Lc,0);
McalfR = MlegR * RkneeR * TcalfR;
PankleR = McalfR * e0 * (~McalfR);

// Tobillo y pie derecho
RankleR = RotorN3(1,0,0,AJRxr)*RotorN3(0,1,0,AJRyr)*RotorN3(0,0,1,AJRzr);
TfootR = TranslatorN3(0, -Hf, 150*x); 
MfootR = McalfR * RankleR * TfootR;
PfootR = MfootR * e0 * (~MfootR);

// Dibujo cuerpo
// Articulaciones (Esferas rojas)
Color(1,0,0);
DrawSphere(Ptorso, 0.15); 
DrawSphere(Pchest, 0.15); 
DrawSphere(Phead, 0.35); 

// Uniones lado izquierdo
DrawSphere(PshoulderL, 0.15); 
DrawSphere(PelbowL, 0.15); 
DrawSphere(PhandL, 0.15);
DrawSphere(PhipL, 0.15); 
DrawSphere(PkneeL, 0.15); 
DrawSphere(PankleL, 0.15);

// Uniones lado derecho
DrawSphere(PshoulderR, 0.15); 
DrawSphere(PelbowR, 0.15); 
DrawSphere(PhandR, 0.15);
DrawSphere(PhipR, 0.15); 
DrawSphere(PkneeR, 0.15); 
DrawSphere(PankleR, 0.15);

// Huesos (Cilindros azules)
Color(0,0.5,1);

// Columna central
Cilindro(Ptorso, Pchest, 0.1);
Cilindro(Pchest, Phead, 0.1);

// Conexiones de hombros y caderas al centro
Cilindro(Pchest, PshoulderL, 0.1); 
Cilindro(Pchest, PshoulderR, 0.1);
Cilindro(Ptorso, PhipL, 0.1);      
Cilindro(Ptorso, PhipR, 0.1);

// Brazos
Cilindro(PshoulderL, PelbowL, 0.1); 
Cilindro(PelbowL, PhandL, 0.1);
Cilindro(PshoulderR, PelbowR, 0.1); 
Cilindro(PelbowR, PhandR, 0.1);

// Piernas
Cilindro(PhipL, PkneeL, 0.1); 
Cilindro(PkneeL, PankleL, 0.1);
Cilindro(PankleL, PfootL, 0.1);
Cilindro(PhipR, PkneeR, 0.1); 
Cilindro(PkneeR, PankleR, 0.1);
Cilindro(PankleR, PfootR, 0.1);