DefVarsN3(); 
DrawFrame(0.5, "axes"); 

// Funcion de clase
Cilindro =
{
    A = _P(1); B = _P(2); r = _P(3);
    E = einf^e0; 
    Ae = (A^E)*E; 
    Be = (B^E)*E; 
    Ce = Be - Ae; 
    C = Ce + 1/2*Ce^^2*einf + e0; 
    DrawCylinder(A, C, r);
}

// =========================================================================
// LÓGICA DE ANIMACIÓN
// =========================================================================
:IPNS;
EnableAnimate(CheckBox("Animar", 0));

if(ExecMode & !EM_ANIMATE)
{
    Data = ReadData("datos.dat");
    ?N = Size(Data);
}

// Índice de animación
?i = round(Time*200, 0)%N + 1;

// =========================================================================
// SLIDERS 
// =========================================================================

// Cuerpo Global y Tronco
px = Slider("Pos X", -5, 5, 0.1, 0);
py = Slider("Pos Y", 0, 10, 0.1, 8.1);
pz = Slider("Pos Z", -5, 5, 0.1, 0);
BFx = Slider("Cintura X (BFx)", -0.8, 0.8, 0.01, 0);
BFz = Slider("Cintura Z (BFz)", -0.5, 0.5, 0.01, 0);

// Cuello 
LNJxr = Slider("Cuello X", -0.7, 0.7, 0.1, 0);
LNJyr = Slider("Cuello Y", -1.2, 1.2, 0.1, 0);

// Brazo Izquierdo (L)
SJLxr = Slider("Hombro L X", -Pi, Pi, 0.1, 0);
SJLyr = Slider("Hombro L Y", -1.5, 1.5, 0.1, 0);
SJLzr = Slider("Hombro L Z", -Pi, 0.5, 0.1, 0);
EJLxr = Slider("Codo L X", -2.5, 0, 0.1, 0);

// Brazo Derecho (R)
SJRxr = Slider("Hombro R X", -Pi, Pi, 0.1, 0);
SJRyr = Slider("Hombro R Y", -1.5, 1.5, 0.1, 0);
SJRzr = Slider("Hombro R Z", -0.5, Pi, 0.1, 0);
EJRxr = Slider("Codo R X", -2.5, 0, 0.1, 0);

// Pierna Izquierda (L) 
HJLxr = Slider("Cadera L X", -1.5, 0.5, 0.1, 0);
HJLyr = Slider("Cadera L Y", -0.5, 0.5, 0.1, 0); 
HJLzr = Slider("Cadera L Z", -0.5, 0.5, 0.1, 0); 
KJLxr = Slider("Rodilla L X", 0, 2.5, 0.1, 0);
AJLxr = Slider("Tobillo L X", -0.8, 0.8, 0.1, 0); 
AJLyr = Slider("Tobillo L Y", -0.5, 0.5, 0.1, 0); 
AJLzr = Slider("Tobillo L Z", -0.5, 0.5, 0.1, 0); 

// Pierna Derecha (R)
HJRxr = Slider("Cadera R X", -1.5, 0.5, 0.1, 0);
HJRyr = Slider("Cadera R Y", -0.5, 0.5, 0.1, 0); 
HJRzr = Slider("Cadera R Z", -0.5, 0.5, 0.1, 0); 
KJRxr = Slider("Rodilla R X", 0, 2.5, 0.1, 0);
AJRxr = Slider("Tobillo R X", -0.8, 0.8, 0.1, 0); 
AJRyr = Slider("Tobillo R Y", -0.5, 0.5, 0.1, 0); 
AJRzr = Slider("Tobillo R Z", -0.5, 0.5, 0.1, 0); 

// Mapeo de datos (Si el checkbox está activo)
if (CheckBox("Animar")) {
    BFx = Data(i, 1);
    BFz = Data(i, 2);
    SJLxr = Data(i, 3);
}

// =========================================================================
// CINEMÁTICA
// =========================================================================
s = 0.01; // Escala para que se vea en pantalla

// Motor Raíz (Pelvis)
M_global = TranslatorN3(px, py, pz);
P_pelvis = M_global * e0 * (~M_global);

// Tronco
M_trunk = M_global * TranslatorN3(0, 119.8*s, 0) * RotorN3(1,0,0, BFx) * RotorN3(0,0,1, BFz);
P_trunk = M_trunk * e0 * (~M_trunk);
M_neck = M_trunk * TranslatorN3(0, 409.4*s, 0);
P_neck = M_neck * e0 * (~M_neck);

// CABEZA
M_headBase = M_neck * RotorN3(1,0,0, LNJxr) * RotorN3(0,1,0, LNJyr);
P_head = (M_headBase * TranslatorN3(0, 150*s, 0)) * e0 * (~(M_headBase * TranslatorN3(0, 150*s, 0))); // 150mm arriba del cuello

// BRAZO IZQUIERDO (L)
M_armL = M_neck * TranslatorN3(-176.3*s, 0, 0) * RotorN3(1,0,0, SJLxr) * RotorN3(0,1,0, SJLyr) * RotorN3(0,0,1, SJLzr);
P_SJ_L = M_armL * e0 * (~M_armL); 
M_forearmL = M_armL * TranslatorN3(0, -239.3*s, 0) * RotorN3(1,0,0, EJLxr);
P_EJ_L = M_forearmL * e0 * (~M_forearmL); 
P_handL = (M_forearmL * TranslatorN3(0, -250*s, 0)) * e0 * (~(M_forearmL * TranslatorN3(0, -250*s, 0)));

// BRAZO DERECHO (R) 
M_armR = M_neck * TranslatorN3(176.3*s, 0, 0) * RotorN3(1,0,0, SJRxr) * RotorN3(0,1,0, SJRyr) * RotorN3(0,0,1, SJRzr);
P_SJ_R = M_armR * e0 * (~M_armR); 
M_forearmR = M_armR * TranslatorN3(0, -239.3*s, 0) * RotorN3(1,0,0, EJRxr);
P_EJ_R = M_forearmR * e0 * (~M_forearmR);
P_handR = (M_forearmR * TranslatorN3(0, -250*s, 0)) * e0 * (~(M_forearmR * TranslatorN3(0, -250*s, 0)));

// PIERNA IZQUIERDA (L) 
M_legL = M_global * TranslatorN3(-93.35*s, 0, 0) * RotorN3(1,0,0, HJLxr) * RotorN3(0,1,0, HJLyr) * RotorN3(0,0,1, HJLzr);
P_HJ_L = M_legL * e0 * (~M_legL);
M_kneeL = M_legL * TranslatorN3(0, -380.6*s, 0) * RotorN3(1,0,0, KJLxr);
P_KJ_L = M_kneeL * e0 * (~M_kneeL);
M_ankleL = M_kneeL * TranslatorN3(0, -358.6*s, 0) * RotorN3(1,0,0, AJLxr) * RotorN3(0,1,0, AJLyr) * RotorN3(0,0,1, AJLzr);
P_AJ_L = M_ankleL * e0 * (~M_ankleL);
P_footL = (M_ankleL * TranslatorN3(0, -71.8*s, 0)) * e0 * (~(M_ankleL * TranslatorN3(0, -71.8*s, 0)));

// PIERNA DERECHA (R) 
M_legR = M_global * TranslatorN3(93.35*s, 0, 0) * RotorN3(1,0,0, HJRxr) * RotorN3(0,1,0, HJRyr) * RotorN3(0,0,1, HJRzr);
P_HJ_R = M_legR * e0 * (~M_legR);
M_kneeR = M_legR * TranslatorN3(0, -380.6*s, 0) * RotorN3(1,0,0, KJRxr);
P_KJ_R = M_kneeR * e0 * (~M_kneeR);
M_ankleR = M_kneeR * TranslatorN3(0, -358.6*s, 0) * RotorN3(1,0,0, AJRxr) * RotorN3(0,1,0, AJRyr) * RotorN3(0,0,1, AJRzr);
P_AJ_R = M_ankleR * e0 * (~M_ankleR);
P_footR = (M_ankleR * TranslatorN3(0, -71.8*s, 0)) * e0 * (~(M_ankleR * TranslatorN3(0, -71.8*s, 0)));

// =========================================================================
// DIBUJO 
// =========================================================================
Color(1,0,0); // Rojo para articulaciones
DrawSphere(P_pelvis, 0.05); DrawSphere(P_trunk, 0.05); DrawSphere(P_neck, 0.05);
DrawSphere(P_SJ_L, 0.04); DrawSphere(P_EJ_L, 0.04); 
DrawSphere(P_SJ_R, 0.04); DrawSphere(P_EJ_R, 0.04);
DrawSphere(P_HJ_L, 0.04); DrawSphere(P_KJ_L, 0.04); DrawSphere(P_AJ_L, 0.04);
DrawSphere(P_HJ_R, 0.04); DrawSphere(P_KJ_R, 0.04); DrawSphere(P_AJ_R, 0.04);

Color(0.8, 0.8, 0.8); // Color diferente para cabeza y extremidades finales
DrawSphere(P_head, 0.12); 
DrawSphere(P_handL, 0.03); DrawSphere(P_handR, 0.03);

Color(0,0.5,1); // Azul para huesos
Cilindro(P_pelvis, P_trunk, 0.04);
Cilindro(P_trunk, P_neck, 0.04);

// Brazos
Cilindro(P_neck, P_SJ_L, 0.03); Cilindro(P_SJ_L, P_EJ_L, 0.03); Cilindro(P_EJ_L, P_handL, 0.02);
Cilindro(P_neck, P_SJ_R, 0.03); Cilindro(P_SJ_R, P_EJ_R, 0.03); Cilindro(P_EJ_R, P_handR, 0.02);

// Piernas 
Cilindro(P_pelvis, P_HJ_L, 0.03); Cilindro(P_HJ_L, P_KJ_L, 0.03); Cilindro(P_KJ_L, P_AJ_L, 0.02); Cilindro(P_AJ_L, P_footL, 0.02);
Cilindro(P_pelvis, P_HJ_R, 0.03); Cilindro(P_HJ_R, P_KJ_R, 0.03); Cilindro(P_KJ_R, P_AJ_R, 0.02); Cilindro(P_AJ_R, P_footR, 0.02);