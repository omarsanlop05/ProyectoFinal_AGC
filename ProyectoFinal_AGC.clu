DefVarsN3();
DrawFrame(0.5,"axes");

//*
//Función cilindro modificada
Cilindro = {
	//Entrada de datos: _P(#)
	A = _P(1); //Entrada 1: Punto inicial del cilindro
	B = _P(2); //Entrada 2: Punto final del cilindro
	r = _P(3); //Entrada 3: Radio del cilindro
	
	E = einf^e0; //Plano de Minkowski
	Ae = (A^E)*E; //Quitar parte "conformal" a Punto A
	Be = (B^E)*E; //Quitar parte "conformal" a Punto B
	Ce = Be - Ae; //Vector de direcciï¿½n en Euclidiano que va de A a B
	C = Ce + 1/2*Ce^^2*einf + e0; // Vector Ce en conformal
	DrawCylinder(A,C,r);
}

Box = {
	C = _P(1); // Entrada 1: Punto centro de la caja
	X = _P(2); // Entrada 2: Punto direcciï¿½n 1
	Y = _P(3); // Entrada 3: Punto direcciï¿½n 2
	Z = _P(4); // Entrada 4: Punto direcciï¿½n 3
	
	E = einf^e0; // Plano de Minkowski
	D1e = ((X-C)^E)*E;
	D2e = ((Y-C)^E)*E;
	D3e = ((Z-C)^E)*E;
	D1 = D1e + 1/2*D1e^^2*einf + e0;
	D2 = D2e + 1/2*D2e^^2*einf + e0;
	D3 = D3e + 1/2*D3e^^2*einf + e0;
	DrawBox(C,D1,D2,D3);
}

:IPNS;
check = CheckBox("Animar",false);
EnableAnimate(check);

if (ExecMode & !EM_ANIMATE) {
    Data = ReadData("datos.dat");
    ?N = Size(Data);
}

if(check){
//Numero de elementos de la lista
	?i = floor(Time*200)%N+1;
	
////////////////
//Movimiento general
	BFx = Data(i,1);
	BFy = Data(i,2);
	BFz = Data(i,3);
	BFRx = Data(i,4);
	BFRy = Data(i,5);
	BFRz = Data(i,6);

//Columna
	LLJxr = Data(i,7);
	LLJzr = Data(i,8);

//Cuello
	LNJxr = Data(i,9);
	LNJyr = Data(i,10);

//Hombro izquierdo
	SJLxr = Data(i,11);
	SJLyr = Data(i,12);
	SJLzr = Data(i,13);

//Codo izquierdo
	EJLxr = Data(i,14);

//Hombro derecho
	SJRxr = Data(i,15);
	SJRyr = Data(i,16);
	SJRzr = Data(i,17);

//Codo derecho
	EJRxr = Data(i,18);

//Cadera izquierda
	HJLxr = Data(i,19);
	HJLyr = Data(i,20);
	HJLzr = Data(i,21);

//Rodilla izquierda
	KJLxr = Data(i,22);

//Tobillo izquierdo
	AJLxr = Data(i,23);
	AJLyr = Data(i,24);
	AJLzr = Data(i,25);

//Cadera derecha
	HJRxr = Data(i,26);
	HJRyr = Data(i,27);
	HJRzr = Data(i,28);

//Rodilla derecha
	KJRxr = Data(i,29);

//Tobillo derecho
	AJRxr = Data(i,30);
	AJRyr = Data(i,31);
	AJRzr = Data(i,32);
} else {
////////////////
	//Movimiento general
	BFx = Slider("Body Forward X", -5,5,0.1,0);
	BFy = Slider("Body Forward Y", -5,5,0.1,0);
	BFz = Slider("Body Forward Z", -5,5,0.1,0);
	BFRx = Slider("Body Rotation X", -Pi,Pi,0.1,0);
	BFRy = Slider("Body Rotation Y", -Pi,Pi,0.1,0);
	BFRz = Slider("Body Rotation Z", -Pi,Pi,0.1,0);

//Columna
	LLJxr = Slider("Lumbar Rotation X", -5,5,0.1,0);
	LLJzr = Slider("Lumbar Rotation Z", -5,5,0.1,0);

//Cuello
	LNJxr = Slider("Neck Rotation X", -5,5,0.1,0);
	LNJyr = Slider("Neck Rotation Y", -5,5,0.1,0);

//Hombro izquierdo
	SJLxr = Slider("Left Shoulder Rotation X", -5,5,0.1,0);
	SJLyr = Slider("Left Shoulder Rotation Y", -5,5,0.1,0);
	SJLzr = Slider("Left Shoulder Rotation Z", -5,5,0.1,0);

//Codo izquierdo
	EJLxr = Slider("Left Elbow Rotation X", -5,5,0.1,0);

//Hombro derecho
	SJRxr = Slider("Right Shoulder Rotation X", -5,5,0.1,0);
	SJRyr = Slider("Right Shoulder Rotation Y", -5,5,0.1,0);
	SJRzr = Slider("Right Shoulder Rotation Z", -5,5,0.1,0);

//Codo derecho
	EJRxr = Slider("Right Elbow Rotation X", -5,5,0.1,0);

//Cadera izquierda
	HJLxr = Slider("Left Hip Rotation X", -5,5,0.1,0);
	HJLyr = Slider("Left Hip Rotation Y", -5,5,0.1,0);
	HJLzr = Slider("Left Hip Rotation Z", -5,5,0.1,0);

//Rodilla izquierda
	KJLxr = Slider("Left Knee Rotation X", -5,5,0.1,0);

//Tobillo izquierdo
	AJLxr = Slider("Left Anckle Rotation X", -5,5,0.1,0);
	AJLyr = Slider("Left Anckle Rotation Y", -5,5,0.1,0);
	AJLzr = Slider("Left Anckle Rotation Z", -5,5,0.1,0);

//Cadera derecha
	HJRxr = Slider("Right Hip Rotation X", -5,5,0.1,0);
	HJRyr = Slider("Right Hip Rotation Y", -5,5,0.1,0);
	HJRzr = Slider("Right Hip Rotation Z", -5,5,0.1,0);

//Rodilla derecha
	KJRxr = Slider("Right Knee Rotation X", -5,5,0.1,0);

//Tobillo derecho
	AJRxr = Slider("Right Anckle Rotation X", -5,5,0.1,0);
	AJRyr = Slider("Right Anckle Rotation Y", -5,5,0.1,0);
	AJRzr = Slider("Right Anckle Rotation Z", -5,5,0.1,0);
}
////////////////

//Motor global
Mg = TranslatorN3(BFx,BFy,BFz)*RotorN3(1,0,0,BFRx)*RotorN3(0,1,0,BFRy)*RotorN3(0,0,1,BFRz);
M = Mg; //motor auxiliar "acumulado"

////////////////

// Cuerpo
x = 0.005; // Escala 1 = mm
Ptorso = M*e0*(~M); //Punto inicial (origen)

// ===============================
// MEDIDAS HUMANOIDE
// ===============================

Lt = 409.4*x;   // torso
Ln = 120*x;     // cuello

Ls = 176.3*x;   // medio ancho hombros
La = 239.3*x;   // brazo
Lf = 250*x;     // antebrazo

Lh = 186.7*x;   // medio ancho cadera
Hh = 119.8*x;   // altura cadera

Lp = 380.6*x;   // muslo
Lc = 358.6*x;   // pantorrilla

Sk = (207.9-186.7)*x;   // separaciÃ³n rodillas
Sa = (211.6-186.7)*x;   // separaciÃ³n tobillos

Hf = 71.8*x;    // altura pie

// ===============================================================
//  TRONCO Y EXTREMIDADES SUPERIORES
// ===============================================================

// Movimiento lumbar
Rlumbar = RotorN3(1,0,0,LLJxr)*RotorN3(0,0,1,LLJzr);
Tlumbar = TranslatorN3(0,Lt,0);
Mlumbar = Rlumbar * Tlumbar;
Mtorso = M * Mlumbar;
Pchest = Mtorso * e0 * (~Mtorso);

// Movimiento cuello
Rneck = RotorN3(1,0,0,LNJxr)*RotorN3(0,1,0,LNJyr);
Tneck = TranslatorN3(0,Ln,0);
Mneck = Mtorso * Rneck * Tneck;
Phead = Mneck * e0 * (~Mneck);

// Movimiento brazo izquierdo
// Hombro izquierdo
TshoulderL = TranslatorN3(-Ls, 0, 0);
RshoulderL = RotorN3(1,0,0,SJLxr)*RotorN3(0,1,0,SJLyr)*RotorN3(0,0,1,SJLzr);
TarmL = TranslatorN3(0,-La,0);
MarmL = Mtorso * TshoulderL * RshoulderL * TarmL;
PshoulderL = (Mtorso * TshoulderL) * e0 * (~(Mtorso * TshoulderL));
PelbowL = MarmL * e0 * (~MarmL);

// Codo izquierdo
RelbowL = RotorN3(1,0,0,EJLxr);
TforearmL = TranslatorN3(0,-Lf,0);
MforearmL = MarmL * RelbowL * TforearmL;
PhandL = MforearmL * e0 * (~MforearmL);

// Movimiento brazo derecho
// Hombro derecho
TshoulderR = TranslatorN3(Ls, 0, 0);
RshoulderR = RotorN3(1,0,0,SJRxr)*RotorN3(0,1,0,SJRyr)*RotorN3(0,0,1,SJRzr);
TarmR = TranslatorN3(0,-La,0);
MarmR = Mtorso * TshoulderR * RshoulderR * TarmR;
PshoulderR = (Mtorso * TshoulderR) * e0 * (~(Mtorso * TshoulderR));
PelbowR = MarmR * e0 * (~MarmR);

// Codo derecho
RelbowR = RotorN3(1,0,0,EJRxr);
TforearmR = TranslatorN3(0,-Lf,0);
MforearmR = MarmR * RelbowR * TforearmR;
PhandR = MforearmR * e0 * (~MforearmR);

// ===============================================================
// CADERA Y EXTREMIDADES INFERIORES
// ===============================================================

ThipCenter = TranslatorN3(0, -Hh, 0);
MhipCenter = M * ThipCenter;

// Cadera Izquierda
ThipL = TranslatorN3(-(Lh/2), 0, 0);
RhipL = RotorN3(1,0,0,HJLxr)*RotorN3(0,1,0,HJLyr)*RotorN3(0,0,1,HJLzr);
PhipL = (MhipCenter * ThipL) * e0 * (~(MhipCenter * ThipL));

// Cadera Derecha
ThipR = TranslatorN3((Lh/2), 0, 0); 
RhipR = RotorN3(1,0,0,HJRxr)*RotorN3(0,1,0,HJRyr)*RotorN3(0,0,1,HJRzr);
PhipR = (MhipCenter * ThipR) * e0 * (~(MhipCenter * ThipR));

// Pierna izquierda
TlegL = TranslatorN3(0, -Lp, 0);
MlegL = MhipCenter * ThipL * RhipL * TlegL;
PkneeL = MlegL * e0 * (~MlegL);

// Rodilla izquierda
RkneeL = RotorN3(1,0,0,KJLxr);
TcalfL = TranslatorN3(0, -Lc, 0);
McalfL = MlegL * RkneeL * TcalfL;
PankleL = McalfL * e0 * (~McalfL);

// Tobillo Izquierdo
RankleL = RotorN3(1,0,0,AJLxr)*RotorN3(0,1,0,AJLyr)*RotorN3(0,0,1,AJLzr);
TfootL = TranslatorN3(0, -Hf, 50*x); // 50*x proyecta el empeine hacia el frente en Z
MfootL = McalfL * RankleL * TfootL;
PfootL = MfootL * e0 * (~MfootL);


// Pierna derecha
TlegR = TranslatorN3(0, -Lp, 0);
MlegR = MhipCenter * ThipR * RhipR * TlegR; 
PkneeR = MlegR * e0 * (~MlegR);

// Rodilla Derecha
RkneeR = RotorN3(1,0,0,KJRxr);
TcalfR = TranslatorN3(0, -Lc, 0);
McalfR = MlegR * RkneeR * TcalfR;
PankleR = McalfR * e0 * (~McalfR);

// Tobillo Derecho 
RankleR = RotorN3(1,0,0,AJRxr)*RotorN3(0,1,0,AJRyr)*RotorN3(0,0,1,AJRzr);
TfootR = TranslatorN3(0, -Hf, 50*x); 
MfootR = McalfR * RankleR * TfootR;
PfootR = MfootR * e0 * (~MfootR);

// ===============================================================
// DIBUJO DEL CUERPO HUMANOIDE REALISTA
// ===============================================================

// --- 1. CABEZA Y TORSO EXTRA REALISTAS ---
// Cabeza estilizada (una esfera grande y una pequeña para simular la mandíbula)
:Color(0.85, 0.75, 0.65); // Color piel base / neutro
DrawSphere(Phead, 0.28); 

// Torso / Pecho (Usamos volúmenes diferenciados para simular masa muscular)
:Color(0.2, 0.4, 0.8); // Color de la "playera/ropa" (Azul elegante)
Cilindro(Ptorso, Pchest, 0.22); // Caja torácica robusta

// Hombros / Clavícula (Unión fuerte entre los dos hombros)
Cilindro(PshoulderL, PshoulderR, 0.12);
// Cadera / Pelvis estructural
Cilindro(PhipL, PhipR, 0.14);


// --- 2. EXTREMIDADES SUPERIORES (BRAZOS) ---
// Articulaciones de los hombros (Deltoides)
:Color(0.15, 0.35, 0.75);
DrawSphere(PshoulderL, 0.13);
DrawSphere(PshoulderR, 0.13);

// Brazos (Bíceps/Tríceps - Más gruesos arriba, se adelgazan hacia el codo)
:Color(0.85, 0.75, 0.65); // Color piel
Cilindro(PshoulderL, PelbowL, 0.10); 
Cilindro(PshoulderR, PelbowR, 0.10); 

// Codos
:Color(0.8, 0.7, 0.6);
DrawSphere(PelbowL, 0.09);
DrawSphere(PelbowR, 0.09);

// Antebrazos (Estilizados, ligeramente más delgados que el brazo)
:Color(0.85, 0.75, 0.65);
Cilindro(PelbowL, PhandL, 0.08);
Cilindro(PelbowR, PhandR, 0.08);

// Manos (Esferas compactas para simular puños)
:Color(0.8, 0.7, 0.6);
DrawSphere(PhandL, 0.07);
DrawSphere(PhandR, 0.07);


// --- 3. EXTREMIDADES INFERIORES (PIERNAS) ---
// Articulaciones de la cadera
:Color(0.1, 0.2, 0.5); // Color del "pantalón"
DrawSphere(PhipL, 0.14);
DrawSphere(PhipR, 0.14);

// Muslos (Fémur - Es el músculo más grande, requiere un radio mayor)
Cilindro(PhipL, PkneeL, 0.15);
Cilindro(PhipR, PkneeR, 0.15);

// Rodillas
:Color(0.15, 0.25, 0.55);
DrawSphere(PkneeL, 0.12);
DrawSphere(PkneeR, 0.12);

// Pantorrillas (Se van adelgazando hacia el tobillo)
Cilindro(PkneeL, PankleL, 0.11);
Cilindro(PkneeR, PankleR, 0.11);

// Tobillos
:Color(0.2, 0.2, 0.2); // Color de los "zapatos"
DrawSphere(PankleL, 0.09);
DrawSphere(PankleR, 0.09);


// --- 4. PIES REALISTAS (Utilizando tu función Box) ---
// En lugar de un cilindro simple, le damos volumen horizontal al pie con cajas orientadas en el espacio
:Color(0.1, 0.1, 0.1); // Color calzado oscuro

// Pie Izquierdo: Usamos el tobillo como centro trasero y el punto del pie para la dirección del zapato
// Definimos vectores de dirección ortogonales usando propiedades del Álgebra Geométrica
D1_L = PfootL;
D2_L = PankleL + TranslatorN3(0.08, 0, 0) * e0 * (~TranslatorN3(0.08, 0, 0)); // Ancho del pie
D3_L = PankleL + TranslatorN3(0, 0.06, 0) * e0 * (~TranslatorN3(0, 0.06, 0)); // Altura del empeine
Box(PankleL, D1_L, D2_L, D3_L);

// Pie Derecho
D1_R = PfootR;
D2_R = PankleR + TranslatorN3(0.08, 0, 0) * e0 * (~TranslatorN3(0.08, 0, 0));
D3_R = PankleR + TranslatorN3(0, 0.06, 0) * e0 * (~TranslatorN3(0, 0.06, 0));
Box(PankleR, D1_R, D2_R, D3_R);