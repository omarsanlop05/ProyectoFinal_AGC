DefVarsN3();
DrawFrame(0.5,"axes");

//*
//Función cilindro modificada
Cilindro = {
	//Entrada de datos: _P(#)
	A = _P(1); //Entrada 1: Punto inicial del cilindro
	B = _P(2); //Entrada 2: Punto final del cilindro
	r = _P(3); //Entrada 3: Radio del cilindro
	
	E = einf^e0; //Plano de Minkowski
	Ae = (A^E)*E; //Quitar parte "conformal" a Punto A
	Be = (B^E)*E; //Quitar parte "conformal" a Punto B
	Ce = Be - Ae; //Vector de direcciï¿½n en Euclidiano que va de A a B
	C = Ce + 1/2*Ce^^2*einf + e0; // Vector Ce en conformal
	DrawCylinder(A,C,r);
	[C,Ce,"Hola"] // Salida(s)
}

Box = {
	C = _P(1); // Entrada 1: Punto centro de la caja
	X = _P(2); // Entrada 2: Punto dirección 1
	Y = _P(3); // Entrada 3: Punto dirección 2
	Z = _P(4); // Entrada 4: Punto dirección 3
	
	E = einf^e0; // Plano de Minkowski
	D1e = ((X-C)^E)*E;
	D2e = ((Y-C)^E)*E;
	D3e = ((Z-C)^E)*E;
	D1 = D1e + 1/2*D1e^^2*einf + e0;
	D2 = D2e + 1/2*D2e^^2*einf + e0;
	D3 = D3e + 1/2*D3e^^2*einf + e0;
	DrawBox(C,D1,D2,D3);
}

:IPNS;
check = CheckBox("Animar",false);
EnableAnimate(check);

if(ExecMode & !EM_ANIMATE)
{
	Data = ReadData("datos.dat");
	?N = Size(Data);
}

if(check){
//Numero de elementos de la lista
	?i = round(Time*200,0)%N+1;
	
////////////////
//Movimiento general
	BFx = Data(i,1);
	BFy = Data(i,2);
	BFz = Data(i,3);
	BFRx = Data(i,4);
	BFRy = Data(i,5);
	BFRz = Data(i,6);

//Columna
	LLJxr = Data(i,7);
	LLJzr = Data(i,8);

//Cuello
	LNJxr = Data(i,9);
	LNJyr = Data(i,10);

//Hombro izquierdo
	SJLxr = Data(i,11);
	SJLyr = Data(i,12);
	SJLzr = Data(i,13);

//Codo izquierdo
	EJLxr = Data(i,14);

//Hombro derecho
	SJRxr = Data(i,15);
	SJRyr = Data(i,16);
	SJRzr = Data(i,17);

//Codo derecho
	EJRxr = Data(i,18);

//Cadera izquierda
	HJLxr = Data(i,19);
	HJLyr = Data(i,20);
	HJLzr = Data(i,21);

//Rodilla izquierda
	KJLxr = Data(i,22);

//Tobillo izquierdo
	AJLxr = Data(i,23);
	AJLyr = Data(i,24);
	AJLzr = Data(i,25);

//Cadera derecha
	HJRxr = Data(i,26);
	HJRyr = Data(i,27);
	HJRzr = Data(i,28);

//Rodilla derecha
	KJRxr = Data(i,29);

//Tobillo derecho
	AJRxr = Data(i,30);
	AJRyr = Data(i,31);
	AJRzr = Data(i,32);
} else {
////////////////
	//Movimiento general
	BFx = Slider("Body Forward X", -5,5,0.1,0);
	BFy = Slider("Body Forward Y", -5,5,0.1,0);
	BFz = Slider("Body Forward Z", -5,5,0.1,0);
	BFRx = Slider("Body Rotation X", -Pi,Pi,0.1,0);
	BFRy = Slider("Body Rotation Y", -Pi,Pi,0.1,0);
	BFRz = Slider("Body Rotation Z", -Pi,Pi,0.1,0);

//Columna
	LLJxr = Slider("Lumbar Rotation X", -5,5,0.1,0);
	LLJzr = Slider("Lumbar Rotation Z", -5,5,0.1,0);

//Cuello
	LNJxr = Slider("Neck Rotation X", -5,5,0.1,0);
	LNJyr = Slider("Neck Rotation Y", -5,5,0.1,0);

//Hombro izquierdo
	SJLxr = Slider("Left Shoulder Rotation X", -5,5,0.1,0);
	SJLyr = Slider("Left Shoulder Rotation Y", -5,5,0.1,0);
	SJLzr = Slider("Left Shoulder Rotation Z", -5,5,0.1,0);

//Codo izquierdo
	EJLxr = Slider("Left Elbow Rotation X", -5,5,0.1,0);

//Hombro derecho
	SJRxr = Slider("Right Shoulder Rotation X", -5,5,0.1,0);
	SJRyr = Slider("Right Shoulder Rotation Y", -5,5,0.1,0);
	SJRzr = Slider("Right Shoulder Rotation Z", -5,5,0.1,0);

//Codo derecho
	EJRxr = Slider("Right Elbow Rotation X", -5,5,0.1,0);

//Cadera izquierda
	HJLxr = Slider("Left Hip Rotation X", -5,5,0.1,0);
	HJLyr = Slider("Left Hip Rotation Y", -5,5,0.1,0);
	HJLzr = Slider("Left Hip Rotation Z", -5,5,0.1,0);

//Rodilla izquierda
	KJLxr = Slider("Left Knee Rotation X", -5,5,0.1,0);

//Tobillo izquierdo
	AJLxr = Slider("Left Anckle Rotation X", -5,5,0.1,0);
	AJLyr = Slider("Left Anckle Rotation Y", -5,5,0.1,0);
	AJLzr = Slider("Left Anckle Rotation Z", -5,5,0.1,0);

//Cadera derecha
	HJRxr = Slider("Right Hip Rotation X", -5,5,0.1,0);
	HJRyr = Slider("Right Hip Rotation Y", -5,5,0.1,0);
	HJRzr = Slider("Right Hip Rotation Z", -5,5,0.1,0);

//Rodilla derecha
	KJRxr = Slider("Right Knee Rotation X", -5,5,0.1,0);

//Tobillo derecho
	AJRxr = Slider("Right Anckle Rotation X", -5,5,0.1,0);
	AJRyr = Slider("Right Anckle Rotation Y", -5,5,0.1,0);
	AJRzr = Slider("Right Anckle Rotation Z", -5,5,0.1,0);
}
////////////////

//Motor global
Mg = TranslatorN3(BFx,BFy,BFz)*RotorN3(1,0,0,BFRx)*RotorN3(0,1,0,BFRy)*RotorN3(1,0,0,BFRz);
M = Mg; //motor auxiliar "acumulado"

////////////////

// Cuerpo
x = 1; // Escala 1 = mm
PuntoTorso = M*e0*(~M); //Punto inicial (origen)
Lt = 409.4*x;   // torso
Ln = 120*x;		// cuello
Ls = 176.3*x;   // hombros
La = 239.3*x;   // brazo
Lf = 250*x;     // antebrazo
Lh = 186.7*x; 	// ancho cadera
Hh = 119.8*x; 	// altura cadera
Lp = 380.6*x;   // pierna
Lc = 358.6*x;   // pantorrilla
Sk = 207.9*x;   // separación rodillas
Sa = 211.6*x;   // separación tobillos
Hf = 71.8*x;	// altura pues

// Movimiento lumbar
Rlumbar = RotorN3(1,0,0,LLJxr)*RotorN3(0,0,1,LLJzr);
Tlumbar = TranslatorN3(0,Lt,0);
Mlumbar = Rlumbar * Tlumbar;
Mtorso = M * Mlumbar;
Pchest = Mtorso * e0 * (~Mtorso);

// Movimiento cuello
Rneck = RotorN3(1,0,0,LNJxr)*RotorN3(0,1,0,LNJyr);
Tneck = TranslatorN3(0,Ln,0);
Mneck = Mtorso * Rneck * Tneck;
Phead = Mneck * e0 * (~Mneck);

// Movimiento brazo izquierdo
// Hombro izquierdo
TshoulderL = TranslatorN3(-0.5, Lt, 0);
RshoulderL = RotorN3(1,0,0,SJLxr)*RotorN3(0,1,0,SJLyr)*RotorN3(0,0,1,SJLzr);
TarmL = TranslatorN3(0,-La,0);
MarmL = M * TshoulderL * RshoulderL * TarmL;
PelbowL = MarmL * e0 * (~MarmL);

// Codo izquierdo
RelbowL = RotorN3(1,0,0,EJLxr);
TforearmL = TranslatorN3(0,-Lf,0);
MforearmL = MarmL * RelbowL * TforearmL;
PhandL = MforearmL * e0 * (~MforearmL);

// Movimiento brazo derecho
// Hombro derecho
TshoulderL = TranslatorN3(-0.5, Lt, 0);
RshoulderL = RotorN3(1,0,0,SJLxr)*RotorN3(0,1,0,SJLyr)*RotorN3(0,0,1,SJLzr);
TarmL = TranslatorN3(0,-La,0);
MarmL = M * TshoulderL * RshoulderL * TarmL;
PelbowL = MarmL * e0 * (~MarmL);

// Codo derecho
RelbowL = RotorN3(1,0,0,EJLxr);
TforearmL = TranslatorN3(0,-Lf,0);
MforearmL = MarmL * RelbowL * TforearmL;
PhandL = MforearmL * e0 * (~MforearmL);

// Cadera
ThipL = TranslatorN3(-0.3,0,0);
RhipL = RotorN3(1,0,0,HJLxr)*RotorN3(0,1,0,HJLyr)*RotorN3(0,0,1,HJLzr);

// Movimiento piernas
// Pierna izquierda
TlegL = TranslatorN3(0,-Lp,0);
MlegL = M * ThipL * RhipL * TlegL;
PkneeL = MlegL * e0 * (~MlegL);

// Rodilla izquierda
RkneeL = RotorN3(1,0,0,KJLxr);
TcalfL = TranslatorN3(0,-Lc,0);
McalfL = MlegL * RkneeL * TcalfL;
PankleL = McalfL * e0 * (~McalfL);

// Dibujo cuerpo
// Cabeza
Color(1,0.8,0.6);
DrawSphere(Phead,0.25);

// Torso
Color(0.7,0.7,0.7);
Cilindro(Ptorso,Pchest,0.15);

// Brazo
Color(0,0,1);
Cilindro(PshoulderL,PelbowL,0.08);
Cilindro(PelbowL,PhandL,0.06);

// Pierna
Color(1,0,0);
Cilindro(PhipL,PkneeL,0.1);
Cilindro(PkneeL,PankleL,0.08);

// Vectores para caja de "pie"
Bx = M*VecN3(0.3,0,0)*(~M);
By = M*VecN3(0,0.1,0)*(~M);
Bz = M*VecN3(0,0,0.5)*(~M);

:White;
:P1 - 1/2*(0.15)^^2*einf;
//:P2 - 1/2*(0.15)^^2*einf;
::Box(P2,Bx,By,Bz);
:Yellow;
?G = ::Cilindro(O,P1,0.05);
::Cilindro(P1,P2,0.05);
?G(1);

//*/